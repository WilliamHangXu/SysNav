<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile: force UDP-only transport (disable shared memory) for the
  bridge container.

  Why: FastDDS moves same-host data over /dev/shm. The bridge runs as root and
  the host pipeline as your user, so SHM segments created by the container can't
  be opened by the host process (ownership/permissions) even with `ipc: host`
  set -- a FastDDS version skew does the same. The symptom is "topic is listed on
  the host but `ros2 topic echo` hangs" (discovery over UDP works, data over SHM
  doesn't). Forcing UDP loopback bypasses SHM entirely.

  Applied to the bridge participant only (FASTRTPS_DEFAULT_PROFILES_FILE), so it
  forces bridge<->host traffic onto UDP; the host pipeline keeps its defaults.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
