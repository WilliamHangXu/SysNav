# Repo-root colcon artifacts — rebuilt inside the image. Leading slash anchors
# each pattern to the context root so it ONLY matches the top-level dir and does
# NOT clobber legitimately-named vendored source dirs deeper in the tree
# (e.g. src/base_autonomy/vehicle_simulator/log, or-tools/.../absl/log).
/build/
/install/
/log/
/logs/
/runlogs/
/output/
/debug/

# Stale local build artifacts inside the vendored native deps. These are rebuilt
# from scratch in the Dockerfile (which also `rm -rf`s them), and shipping them
# bloats the COPY layers and carries host-absolute CMakeCache paths. Targeted —
# not a blanket **/build — so it can't catch real source dirs elsewhere.
src/slam/dependency/*/build/
src/slam/dependency/*/log/
src/utilities/livox_ros_driver2/Livox-SDK2/build/

# Git
.git/
.gitignore

# Editor / local
.vscode/
.claude/

# Generated images / scratch outputs (root-level only — does not match src icons)
*.png
img/
video/

# Large external inputs (pulled from S3 at runtime, not baked here)
# NOTE: mobileclip2_b.ts is intentionally NOT ignored — it is baked into the image.
bags/
*.bag

# Python caches
**/__pycache__/
**/*.pyc
