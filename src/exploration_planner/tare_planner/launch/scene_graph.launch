import os
import yaml
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.conditions import IfCondition
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration, PythonExpression
from launch_ros.actions import Node

# One bringup launch for the whole scene-graph pipeline. Scenario / export / vlm
# config selection is baked in here so the tmux runner carries only per-run knobs
# (which bag, start offset, playback duration). Starts:
#   <ns>/odom->map static tf, detection_node, semantic_mapping_node,
#   room_segmentation, vlm_node, planner (+ scene-graph exporter), and RViz.
SCENARIO = 'go2w_bag_direct'
SG_EXPORT_CONFIG = 'scene_graph_export'
VLM_CONFIG = 'vlm_config'


def _robot_params(tare_share):
    # The single per-robot config lives in robot.yaml. Read here (at launch-build
    # time) to compose the static <ns>/odom -> map tf; the nodes themselves read
    # the same robot.yaml for their params.
    robot_yaml = os.path.join(tare_share, 'robot.yaml')
    try:
        with open(robot_yaml) as f:
            return yaml.safe_load(f)['/**']['ros__parameters']
    except Exception as e:
        # robot.yaml is the single per-robot config; fail loudly rather than
        # silently assuming a particular robot.
        raise RuntimeError(
            f"[scene_graph.launch] could not read robot.yaml params from "
            f"{robot_yaml}: {e}. It must define "
            f"'/**: ros__parameters: robot_namespace: <ns>'.") from e


def generate_launch_description():
    use_sim_time = LaunchConfiguration('use_sim_time')
    rviz = LaunchConfiguration('rviz')
    objects = LaunchConfiguration('objects')
    decompress = LaunchConfiguration('decompress_camera')

    tare_share = get_package_share_directory('tare_planner')
    sem_share = get_package_share_directory('semantic_mapping')
    vlm_share = get_package_share_directory('vlm_node')

    robot_params = _robot_params(tare_share)
    ns = robot_params['robot_namespace']

    robot_yaml = os.path.join(tare_share, 'robot.yaml')

    # Curated package-root rviz config (the one the prior tmux loaded), NOT the
    # larger rviz/ one that gets installed to share. The installed launch is a
    # symlink back to src, so realpath(__file__) resolves into the source tree:
    #   <pkg>/launch/scene_graph.launch -> <pkg>/tare_planner_ground.rviz
    rviz_config = os.path.join(
        os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
        'tare_planner_ground.rviz')

    def include(path, extra=None, condition=None):
        args = {'use_sim_time': use_sim_time}
        if extra:
            args.update(extra)
        return IncludeLaunchDescription(
            PythonLaunchDescriptionSource(path), launch_arguments=args.items(),
            condition=condition)

    entries = [
        DeclareLaunchArgument('use_sim_time', default_value='true',
                              description='Use sim (bag) clock'),
        DeclareLaunchArgument('rviz', default_value='true',
                              description='Launch RViz alongside the pipeline'),
        # Object mapping toggle. false (default) drops the object branch
        # (detection_node + semantic_mapping_node) and exports scene graphs with
        # rooms + navgraph only -- the planner just sees no object messages and
        # exports an empty object list; room segmentation and navgraph are
        # unaffected. NOTE room labeling still runs but DEGRADES to image-only:
        # the /room_type_query object inventory (the VLM's primary signal) goes
        # empty, so rooms are typed from the best-3 images alone. Set
        # objects:=true to restore the full objects-first pipeline.
        DeclareLaunchArgument('objects', default_value='false',
                              description='Run object detection + mapping branch'),
        # Whether to decode a CompressedImage camera back to the raw
        # <ns>/camera/image_rect_color the pipeline consumes. 'auto' (default) = on
        # when use_sim_time:=false (live/demo, where the ROS 1 bridge carries JPEG to
        # spare the WiFi hop) and off for bag modes -- which historically play the raw
        # topic straight from the bag. supervisor.sh inspects each bag and passes
        # decompress_camera:=true when it carries ONLY the compressed topic (e.g. a
        # bag recorded during a live/demo run), so such bags decode in bag /
        # bag-direct too. 'true'/'false' force it on/off (e.g. a hand-run pipeline).
        DeclareLaunchArgument('decompress_camera', default_value='auto',
                              description='Decode compressed camera -> raw '
                                          'image_rect_color: auto | true | false'),
    ]

    # The registered cloud + odometry come straight from the bag/robot. Static
    # identity <ns>/odom -> map pins the stack's `map` frame to the bag odom
    # (RViz tf tree + optional world<-odom export).
    entries.append(Node(
        package='tf2_ros', executable='static_transform_publisher',
        name='odom_to_map_static',
        arguments=['--x', '0', '--y', '0', '--z', '0',
                   '--yaw', '0', '--pitch', '0', '--roll', '0',
                   '--frame-id', ns + '/odom', '--child-frame-id', 'map'],
        parameters=[{'use_sim_time': use_sim_time}], output='screen'))

    entries += [
        # The camera can arrive COMPRESSED (JPEG): live/demo bridge JPEG over the
        # ROS 1 hop to spare the WiFi (bridging raw frames saturated it), and a bag
        # recorded during a live/demo run therefore captures the compressed topic
        # too. Decode it back to the raw /<ns>/camera/image_rect_color the planner
        # (and, with objects:=true, the detection node) already subscribe to, so
        # nothing downstream changes. republish is LAZY: it only decodes while a
        # consumer is attached, and in this image_transport version the transports
        # are PARAMETERS (in_transport/out_transport) -- the old positional
        # `republish compressed raw` CLI form silently no-ops. Gated by
        # decompress_camera (see the DeclareLaunchArgument above): on for live/demo,
        # and on for bag modes only when supervisor.sh finds the bag carries ONLY the
        # compressed topic (raw-only bags play through untouched -- no double-publish).
        Node(package='image_transport', executable='republish',
             name='camera_decompress',
             parameters=[{'in_transport': 'compressed', 'out_transport': 'raw',
                          'use_sim_time': use_sim_time}],
             remappings=[('in/compressed',
                          f'/{ns}/camera/image_rect_color/compressed'),
                         ('out', f'/{ns}/camera/image_rect_color')],
             condition=IfCondition(PythonExpression([
                 "'", decompress, "' == 'true' or ('", decompress,
                 "' == 'auto' and '", use_sim_time, "' == 'false')"])),
             output='screen'),
        include(os.path.join(sem_share, 'detection_node_go2w_bag.launch'),
                condition=IfCondition(objects)),
        include(os.path.join(sem_share, 'semantic_mapping_go2w_bag.launch'),
                condition=IfCondition(objects)),
        include(os.path.join(tare_share, 'room_segmentation.launch'),
                {'scenario': SCENARIO, 'robot_config': robot_yaml}),
        include(os.path.join(vlm_share, 'vlm_node.launch'),
                {'config': VLM_CONFIG}),
        include(os.path.join(tare_share, 'explore.launch'),
                {'scenario': SCENARIO, 'sg_export_config': SG_EXPORT_CONFIG,
                 'robot_config': robot_yaml}),

        Node(package='rviz2', executable='rviz2', name='rviz2',
             arguments=['-d', rviz_config],
             parameters=[{'use_sim_time': use_sim_time}],
             condition=IfCondition(rviz), output='screen'),
    ]

    return LaunchDescription(entries)
